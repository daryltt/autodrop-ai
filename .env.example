# ----------------------------------------------------------------------------
# AutoDrop AI environment variables
# Copy this file to .env and adjust values for your environment.
# Phase 1 ships with safe local defaults and does not require AI API keys.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
APP_NAME=AutoDrop AI
APP_URL=http://localhost:3000

# Database
POSTGRES_USER=autodrop
POSTGRES_PASSWORD=autodrop_secret
POSTGRES_DB=autodrop
DATABASE_URL=******localhost:5432/autodrop

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Encryption
# 32 bytes encoded as 64 hex characters.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage
# Supported values: local | minio
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=autodrop
MINIO_REGION=us-east-1

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed defaults
SEED_ADMIN_EMAIL=admin@autodrop.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_STORE_NAME=AutoDrop Demo Store
SEED_STORE_SLUG=autodrop-demo

# Optional AI provider keys (all optional in Phase 1)
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
